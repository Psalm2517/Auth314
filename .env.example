# Auth314 environment variables.
#
# On Cloudflare: PI_CLIENT_ID and PUBLIC_URL live in wrangler.toml [vars];
# AUTH_SECRET is set with `wrangler secret put AUTH_SECRET`.
# On Vercel: set all of these as project environment variables.

# Bearer token your own integrations send to POST /verify/init.
AUTH_SECRET=

# Pi OAuth client id, from the Pi Developer Portal. Public value.
PI_CLIENT_ID=

# Optional. Only needed if the public URL differs from the request Host
# (e.g. behind a proxy). Otherwise the request origin is used.
# PUBLIC_URL=https://auth.example.com

# --- Vercel only ---
# Set automatically when you link an Upstash Redis / Vercel KV store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
