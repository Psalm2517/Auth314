# Auth314 configuration.
#
# PI_CLIENT_ID and PUBLIC_URL live in wrangler.toml [vars].
# AUTH_SECRET is a secret: `npx wrangler secret put AUTH_SECRET`.
#
# For `wrangler dev`, copy this file to .dev.vars (which is gitignored).

# Bearer token your own app sends to POST /verify/init.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Pi OAuth client id, from the Pi Developer Portal. Public value, no secret exists.
PI_CLIENT_ID=

# Optional. Only needed if the public URL differs from the request Host
# (e.g. behind a proxy). Otherwise the request origin is used.
# PUBLIC_URL=https://auth.example.com
